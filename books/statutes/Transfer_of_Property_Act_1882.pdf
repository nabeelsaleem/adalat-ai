        width: auto; /* Adjust width as needed for responsiveness */
        line-height: 1; /* Adjust line height to remove extra space */
    }
}

/* Adjustments for desktop screens */
@media only screen and (min-width: 768px) {
    .disclaimer {
        font-size: 13px;
        width: 800px;
        line-height: 1; /* Adjust line height to remove extra space */
    }
}

</style>
</body>
</html>
