<style>
/* Tooltip container */
.tooltipss {
  position: relative;
}

/* Tooltip text */
.tooltipss .tooltip-text {
  visibility: hidden;
  opacity: 0;
  position: absolute;
  top: 130%; /* BELOW the link */
  left: 50%;
  transform: translateX(-50%);
  background-color: #28a745;
  color: #fff;
  padding: 6px 10px;
  font-size: 0.75rem;
  border-radius: 4px;
  white-space: nowrap;
  transition: opacity 0.3s ease;
  z-index: 999;
}

/* Arrow (points UP) */
.tooltipss .tooltip-text::after {
  content: "";
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  border-width: 6px;
  border-style: solid;
  border-color: transparent transparent #28a745 transparent;
}

/* Show tooltip on hover */
.tooltipss:hover .tooltip-text {
  visibility: visible;
  opacity: 1;
}
.blink-new {
  margin-left: 2px;
  padding: 2px 6px;
  font-size: 11px;
  font-weight: bold;
  color: #fff;
  background-color: #e60000;
  border-radius: 4px;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%   { opacity: 1; }
  50%  { opacity: 0; }
  100% { opacity: 1; }
}


</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
  var languageToggle = document.getElementById('languageToggle');
  var languageDropdown = document.getElementById('languageDropdown');
  var enLink = document.getElementById('enLink');
  var urLink = document.getElementById('urLink');
  var currentLanguageSpan = document.getElementById('currentLanguage');

  function updateLanguageLinks() {
    if (window.location.href.includes('UHyrdu.php')) { // Check if on UR page
      currentLanguageSpan.textContent = 'UR';
      enLink.style.display = 'block'; // Show EN link on UR page
    } else {
      currentLanguageSpan.textContent = 'EN';
      enLink.style.display = 'none'; // Hide EN link on other pages
    }
  }

  updateLanguageLinks(); // Update initially

  languageToggle.addEventListener('click', function () {
    languageDropdown.style.display = languageDropdown.style.display === 'none' ? 'block' : 'none';
  });

  var languageLinks = languageDropdown.querySelectorAll('a');
  languageLinks.forEach(function (link) {
    link.addEventListener('click', function (event) {
      event.preventDefault();
      languageDropdown.style.display = 'none';
      window.location.href = this.href;
      updateLanguageLinks(); // Update language display after redirect
    });
  });
});

</script>


